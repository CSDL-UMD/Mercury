 {
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "simple": {
      "format": "[%(levelname)s|%(module)s|L%(lineno)d] %(asctime)s: %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    },
    "json": {
      "()": "mercurylogger_utils.MyJSONFormatter",
      "fmt_keys": {
        "level": "levelname",
        "message": "message",
        "timestamp": "timestamp",
        "logger": "name",
        "module": "module",
        "function": "funcName",
        "line": "lineno",
        "thread_name": "threadName"
      }
    }
  },
  "filters": {
    "moreThanInfoFilter": {
      "()": "mercurylogger_utils.MoreThanInfoFilter"
    },
    "auth_qualtrics_filter": {
      "()": "mercurylogger_utils.AuthQualtricsFilter"
    },
    "compliance_filter": {
      "()": "mercurylogger_utils.ComplianceFilter"
    },
    "compliance_voluntary_filter": {
      "()": "mercurylogger_utils.ComplianceVoluntaryFilter"
    },
    "database_filter": {
      "()": "mercurylogger_utils.DatabaseFilter"
    },
    "eligibility_filter": {
      "()": "mercurylogger_utils.EligibilityFilter"
    },
    "muting_filter": {
      "()": "mercurylogger_utils.MutingFilter"
    },
    "unmuting_filter": {
      "()": "mercurylogger_utils.UnmutingFilter"
    },
    "pre_engagements_filter": {
      "()": "mercurylogger_utils.PreEngagementsFilter"
    },
    "post_engagements_filter": {
      "()": "mercurylogger_utils.PostEngagementsFilter"
    },
    "post_endline_engagements_filter": {
      "()": "mercurylogger_utils.PostEndlineEngagementsFilter"
    },
    "pre_engagements_parse_filter": {
      "()": "mercurylogger_utils.PreEngagementsParseFilter"
    },
    "post_engagements_parse_filter": {
      "()": "mercurylogger_utils.PostEngagementsParseFilter"
    },
    "post_endline_engagements_parse_filter": {
      "()": "mercurylogger_utils.PostEndlineEngagementsParseFilter"
    },
    "post_endline_at_once_filter": {
      "()": "mercurylogger_utils.PostEndlineAtOnceFilter"
    },
    "post_endline_at_once_parse_filter": {
      "()": "mercurylogger_utils.PostEndlineAtOnceParseFilter"
    }
  },
  "handlers": {
    "default": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/default_log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3
    },
    "stderr": {
      "class": "logging.StreamHandler",
      "level": "WARNING",
      "formatter": "simple",
      "stream": "ext://sys.stderr"
    },
    "auth_qualtrics": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/auth_qualtrics/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "auth_qualtrics_filter",
        "moreThanInfoFilter"
      ]
    },
    "compliance": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/compliance/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "compliance_filter",
        "moreThanInfoFilter"
      ]
    },
    "compliance_voluntary": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/compliance_voluntary/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "compliance_voluntary_filter",
        "moreThanInfoFilter"
      ]
    },
    "database": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/database/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "database_filter",
        "moreThanInfoFilter"
      ]
    },
    "eligibility": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/eligibility/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "eligibility_filter",
        "moreThanInfoFilter"
      ]
    },
    "muting": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/muting/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "muting_filter",
        "moreThanInfoFilter"
      ]
    },
    "unmuting": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/unmuting/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "unmuting_filter",
        "moreThanInfoFilter"
      ]
    },
    "pre_engagements": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/pre_engagements/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "pre_engagements_filter",
        "moreThanInfoFilter"
      ]
    },
    "post_engagements": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/post_engagements/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "post_engagements_filter",
        "moreThanInfoFilter"
      ]
    },
    "post_endline_engagements": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/post_endline_engagements/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "post_endline_engagements_filter",
        "moreThanInfoFilter"
      ]
    },
    "pre_engagements_parse": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/pre_engagements_parse/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "pre_engagements_parse_filter",
        "moreThanInfoFilter"
      ]
    },
    "post_engagements_parse": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/post_engagements_parse/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "post_engagements_parse_filter",
        "moreThanInfoFilter"
      ]
    },
     "post_endline_engagements_parse": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/post_endline_engagements_parse/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "post_endline_engagements_parse_filter",
        "moreThanInfoFilter"
      ]
    },
    "post_endline_at_once": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/post_endline_at_once/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "post_endline_at_once_filter",
        "moreThanInfoFilter"
      ]
    },
    "post_endline_at_once_parse": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/post_endline_at_once_parse/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "post_endline_at_once_parse_filter",
        "moreThanInfoFilter"
      ]
    }
  },
  "loggers": {
    "root": {
      "level": "DEBUG",
      "handlers": [
        "stderr",
        "auth_qualtrics",
        "compliance",
        "compliance_voluntary",
        "database",
        "default",
        "eligibility",
        "muting",
        "unmuting",
        "pre_engagements",
        "post_engagements",
        "post_endline_engagements",
        "pre_engagements_parse",
        "post_engagements_parse",
        "post_endline_engagements_parse",
        "post_endline_at_once",
        "post_endline_at_once_parse"
      ]
    }
  }
}
