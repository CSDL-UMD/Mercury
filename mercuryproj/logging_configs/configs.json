 {
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "simple": {
      "format": "[%(levelname)s|%(module)s|L%(lineno)d] %(asctime)s: %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    },
    "json": {
      "()": "mercurylogger_utils.MyJSONFormatter",
      "fmt_keys": {
        "level": "levelname",
        "message": "message",
        "timestamp": "timestamp",
        "logger": "name",
        "module": "module",
        "function": "funcName",
        "line": "lineno",
        "thread_name": "threadName"
      }
    }
  },
  "filters": {
    "moreThanInfoFilter": {
      "()": "mercurylogger_utils.MoreThanInfoFilter"
    },
    "compliance_filter": {
      "()": "mercurylogger_utils.ComplianceFilter"
    },
    "database_filter": {
      "()": "mercurylogger_utils.DatabaseFilter"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "level": "WARNING",
      "formatter": "simple",
      "stream": "ext://sys.stderr"
    },
    "compliance": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/compliance/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "compliance_filter"
      ]
    },
    "database": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "logs/database/log.jsonl",
      "maxBytes": 10000,
      "backupCount": 3,
      "filters": [
        "database_filter"
      ]
    }
  },
  "loggers": {
    "root": {
      "level": "DEBUG",
      "handlers": [
        "stderr",
        "compliance",
        "database"
      ]
    }
  }
}
